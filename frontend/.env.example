# API Backend URL (Use http://localhost:8000 when running php -S, or http://localhost/backend_gestionPro for Apache)
VITE_API_URL=http://localhost:8000

# (Optionnel) Configuration EmailJS pour tester l'envoi d'emails :
# Laissez vide par défaut. Si vous souhaitez tester les notifications email, renseignez vos propres clés EmailJS :
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_OFFER_TEMPLATE_ID=
VITE_EMAILJS_COMPLETION_TEMPLATE_ID=
